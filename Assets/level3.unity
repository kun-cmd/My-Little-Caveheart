  stress: 6
  usedMinutes: 0
  bodyConnected: 0
  realityConnected: 0
  futureConnected: 0
  pencilPlaced: 0
  thoughtText: {fileID: 390004}
  thoughtSlots:
  - {fileID: 391004}
  - {fileID: 392004}
  feedback: {fileID: 210002}
  paperQuestionText: {fileID: 321002}
  paperDropCollider: {fileID: 320004}
  thoughtCursorHintText: {fileID: 224002}
  cursorVisuals: {fileID: 200003}
  thoughtPointerInteraction: {fileID: 200004}
  endScreen: {fileID: 200005}
  fragmentRoot: {fileID: 400001}
  fallingSkyArea: {fileID: 0}
  littleCaveheart: {fileID: 0}
  littleCaveheartRenderer: {fileID: 1967626394}
  deskRenderer: {fileID: 0}
  paperRenderer: {fileID: 0}
  stageLayouts:
  - completeText: 'You can see two pieces now.

      A feeling, and a guess.'
    thoughts:
    - thought: I am going to fail.
      thoughtComponent: {fileID: 390004}
      textComponent: {fileID: 390002}
      fragments:
      - text: I am scared.
        kind: 0
        fragmentComponent: {fileID: 401004}
        textComponent: {fileID: 401002}
      - text: I might fail.
        kind: 2
        fragmentComponent: {fileID: 402004}
        textComponent: {fileID: 402002}
  - completeText: Both fears are smaller when they are sorted.
    thoughts:
    - thought: Everyone will be disappointed in me.
      thoughtComponent: {fileID: 391004}
      textComponent: {fileID: 391002}
      fragments:
      - text: I am afraid of disappointing people.
        kind: 2
        fragmentComponent: {fileID: 403004}
        textComponent: {fileID: 403002}
      - text: No one has seen my test yet.
        kind: 1
        fragmentComponent: {fileID: 404004}
        textComponent: {fileID: 404002}
    - thought: I will not get into college.
      thoughtComponent: {fileID: 392004}
      textComponent: {fileID: 392002}
      fragments:
      - text: I am imagining a far-away result.
        kind: 2
        fragmentComponent: {fileID: 405004}
        textComponent: {fileID: 405002}
      - text: The result has not happened yet.
        kind: 1
        fragmentComponent: {fileID: 406004}
        textComponent: {fileID: 406002}
  - completeText: 'The sky is still loud.

      But it is not the whole world.'
    thoughts:
    - thought: This exam will ruin everything.
      thoughtComponent: {fileID: 390004}
      textComponent: {fileID: 390002}
      fragments:
      - text: My chest feels tight.
        kind: 0
        fragmentComponent: {fileID: 407004}
        textComponent: {fileID: 407002}
      - text: This is one page on a desk.
        kind: 1
        fragmentComponent: {fileID: 408004}
        textComponent: {fileID: 408002}
      - text: I am afraid this will ruin everything.
        kind: 2
        fragmentComponent: {fileID: 409004}
        textComponent: {fileID: 409002}
  pressureMusicVolume: 0.32
  groundedMusicVolume: 0.34
  musicCrossfadeSeconds: 2
  pressureMusicClip: {fileID: 8300000, guid: fd52499e40f685648b595fe6e1bc3b38, type: 3}
  groundedMusicClip: {fileID: 8300000, guid: 41563cc3015519148a4d1cc719c1c2e6, type: 3}
  interactionSfxVolume: 0.78
